# Previa — copy to .env and fill in locally. Never commit a real key.

# Listen address for the HTTP server.
PREVIA_ADDR=:8080

# Canonical base URL, used for canonical links, hreflang and the sitemap.
PREVIA_BASE_URL=https://previa.estate

# Recompile templates on every request and show template errors in the browser.
PREVIA_DEV=1

# Market shown before a visitor chooses one (ISO 3166-1 alpha-2).
PREVIA_DEFAULT_COUNTRY=EE

# Google Maps JavaScript API key.
# Leave empty to use Previa's built-in mock map, which keeps every marker,
# popup and card-synchronisation behaviour working without a billable key.
PREVIA_MAPS_API_KEY=

# Template and static roots, if the binary is not run beside web/.
# PREVIA_TEMPLATE_DIR=web/templates
# PREVIA_STATIC_DIR=web/static
